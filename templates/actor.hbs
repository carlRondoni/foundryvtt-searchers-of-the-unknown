<section class="sotu-sheet">
  <header class="sotu-header">
    <input class="sotu-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'SOTU.Sheet.Name'}}">
  </header>

  <nav class="sotu-tabs">
    {{#each tabs}}
      <button type="button" class="sotu-tab {{#if this.active}}active{{/if}}" data-action="changeTab" data-nav-tab="{{this.id}}">{{this.label}}</button>
    {{/each}}
  </nav>

  {{!-- ===================== TAB: SHEET ===================== --}}
  <div class="sotu-panel {{#if showSheet}}active{{/if}}" data-panel="sheet">

    <div class="sotu-stats">
      <div class="stat"><label>{{localize 'SOTU.Sheet.AC'}}</label>
        {{#if isCharacter}}<span class="big">{{system.ac}}</span>
        {{else}}<input type="number" name="system.ac" value="{{system.ac}}">{{/if}}
      </div>
      <div class="stat"><label>{{localize 'SOTU.Sheet.MV'}}</label>
        {{#if isCharacter}}<span class="big">{{system.mv}}</span>
        {{else}}<input type="number" name="system.mv" value="{{system.mv}}">{{/if}}
      </div>
      <div class="stat"><label>{{#if isCharacter}}{{localize 'SOTU.Sheet.LevelHD'}}{{else}}{{localize 'SOTU.Sheet.HD'}}{{/if}}</label>
        {{#if isCharacter}}<input type="number" name="system.level" value="{{system.level}}" min="1">
        {{else}}<input type="number" name="system.hd" value="{{system.hd}}" min="1">{{/if}}
      </div>
      <div class="stat"><label>{{localize 'SOTU.Sheet.Attacks'}}</label>
        {{#if isCharacter}}<span class="big">{{system.attacks}}</span>
        {{else}}<input type="number" name="system.attacks" value="{{system.attacks}}" min="1">{{/if}}
      </div>
      <div class="stat hp"><label>{{localize 'SOTU.Sheet.HP'}}</label>
        <span class="hp-inputs">
          <input type="number" name="system.hp.value" value="{{system.hp.value}}">
          /
          <input type="number" name="system.hp.max" value="{{system.hp.max}}" min="0">
        </span>
      </div>
    </div>

    {{#if isCharacter}}
    <fieldset class="sotu-gear">
      <legend>{{localize 'SOTU.Sheet.GearLegend'}}</legend>
      <label>{{localize 'SOTU.Sheet.Armor'}}
        <select name="system.armor">{{selectOptions armors selected=system.armor}}</select>
      </label>
      <label class="inline"><input type="checkbox" name="system.shield" {{checked system.shield}}> {{localize 'SOTU.Sheet.Shield'}}</label>
      <label>{{localize 'SOTU.Sheet.XP'}} <input type="number" name="system.xp" value="{{system.xp}}" min="0"> / {{system.xpNeeded}}</label>
      <div class="buttons">
        {{#unless system.hpRolled}}
          <button type="button" data-action="rollHP">{{localize 'SOTU.Sheet.RollHP' level=system.level}}</button>
        {{/unless}}
        <button type="button" data-action="levelUp">{{localize 'SOTU.Sheet.LevelUp'}}</button>
      </div>
    </fieldset>
    {{else}}
    <fieldset class="sotu-gear">
      <legend>{{localize 'SOTU.Sheet.MonsterLegend'}}</legend>
      <label>{{localize 'SOTU.Sheet.Damage'}} <input type="text" name="system.damage" value="{{system.damage}}"></label>
      <div>{{localize 'SOTU.Sheet.XPValue'}} <b>{{system.xpValue}}</b></div>
    </fieldset>
    {{/if}}

    <fieldset class="sotu-actions">
      <legend>{{localize 'SOTU.Sheet.ActionsLegend'}}</legend>
      <div class="buttons">
        <button type="button" data-action="attack">{{localize 'SOTU.Sheet.Attack'}}{{#unless isCharacter}} ({{system.damage}}){{/unless}}</button>
        <button type="button" data-action="stealth">{{localize 'SOTU.Sheet.Stealth'}}</button>
        <button type="button" data-action="save">{{localize 'SOTU.Sheet.Save'}}</button>
        <button type="button" data-action="rest">{{localize 'SOTU.Sheet.Rest'}}</button>
        {{#unless isCharacter}}<button type="button" data-action="morale">{{localize 'SOTU.Sheet.Morale'}}</button>{{/unless}}
      </div>
      <div class="buttons">
        <span>{{localize 'SOTU.Sheet.Danger'}}</span>
        <button type="button" data-action="danger" data-dice="1d8">1d8</button>
        <button type="button" data-action="danger" data-dice="2d8">2d8</button>
        <button type="button" data-action="danger" data-dice="4d8">4d8</button>
      </div>
    </fieldset>

    <fieldset class="sotu-weapons">
      <div class="sotu-weapons-header">
        <span class="title">{{localize 'SOTU.Sheet.Weapons'}}</span>
        <div class="sotu-weapons-buttons">
          <button type="button" data-action="addWeapon" title="{{localize 'SOTU.Sheet.AddWeapon'}}">+</button>
        </div>
      </div>
      <ul>
        {{#each weapons}}
        <li data-item-id="{{this.id}}">
          <img src="{{this.img}}" width="24" height="24">
          <span class="wname">{{this.name}}</span>
          <span>{{this.system.damage}}</span>
          <button type="button" data-action="attack" data-item-id="{{this.id}}">{{localize 'SOTU.Sheet.Attack'}}</button>
          <button type="button" data-action="editWeapon" title="{{localize 'SOTU.Sheet.EditWeapon'}}">✎</button>
          <button type="button" data-action="deleteWeapon" title="{{localize 'SOTU.Sheet.DeleteWeapon'}}">🗑</button>
        </li>
        {{/each}}
      </ul>
    </fieldset>
  </div>

  {{!-- ============ TAB: BACKGROUND / DESCRIPTION ============ --}}
  <div class="sotu-panel {{#if showBackground}}active{{/if}}" data-panel="background">

    {{#if isCharacter}}
      <div class="sotu-race">
        <select name="system.race">{{selectOptions races selected=system.race}}</select>
      </div>
    {{/if}}

    <textarea class="sotu-bio" name="system.biography" placeholder="{{localize 'SOTU.Sheet.BioPlaceholder'}}">{{system.biography}}</textarea>
  </div>
</section>
