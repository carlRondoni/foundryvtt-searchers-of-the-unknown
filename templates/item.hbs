<section class="sotu-sheet">
  <input class="sotu-name" type="text" name="name" value="{{item.name}}" placeholder="{{localize 'SOTU.Sheet.Name'}}">
  <label>{{localize 'SOTU.Sheet.ItemCategory'}}
    <select name="system.category">{{selectOptions categories selected=system.category}}</select>
  </label>
  <div>{{localize 'SOTU.Sheet.ItemDamage'}} <b>{{system.damage}}</b></div>
  <textarea name="system.description" placeholder="{{localize 'SOTU.Sheet.ItemDescription'}}">{{system.description}}</textarea>
</section>
